services:
{% if backend.enabled %}
  backend:
    build: {{ backend_root[:-1] if backend_root else "." }}
    ports:
{% if backend.language == "node" %}
      - "3000:3000"
{% else %}
      - "8000:8000"
{% endif %}
{% if environment.enabled %}
    env_file:
      - path: .env
        required: false
{% endif %}
{% if database.enabled %}
    environment:
{% if backend.language == "node" %}
      DATABASE_URL: "{{ database.compose_url }}"
      DB_HOST: db
      DB_PORT: "5432"
      DB_USER: {{ database.compose.user }}
      DB_PASSWORD: {{ database.compose.password }}
      DB_NAME: {{ database.compose.name }}
{% else %}
      DATABASE_URL: "{{ database.compose_url }}"
{% endif %}
    depends_on:
      db:
        condition: service_healthy
{% endif %}
{% endif %}
{% if frontend.enabled %}
  frontend:
    image: node:20-alpine
    working_dir: /app
    volumes:
      - ./{{ frontend_root[:-1] if frontend_root else "." }}:/app
      - /app/node_modules
    command: ["sh", "-c", "npm install && npm run dev -- --host 0.0.0.0"]
    ports:
      - "5173:5173"
{% if backend.enabled %}
    depends_on:
      - backend
{% endif %}
{% endif %}
{% if database.enabled %}
  db:
    image: {{ database.provider }}:16
    environment:
      POSTGRES_USER: {{ database.compose.user }}
      POSTGRES_PASSWORD: {{ database.compose.password }}
      POSTGRES_DB: {{ database.compose.name }}
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ database.compose.user }} -d {{ database.compose.name }}"]
      interval: 5s
      timeout: 5s
      retries: 10
{% endif %}
