# ====================================================================
# Vantage Commerce Platform – Backend API — environment configuration (.env.example)
# Generated by env_file_generator from the design artifacts.
# Copy to .env and fill in real values. NEVER commit a real .env.
# ====================================================================

# --- Core / Runtime ---
# Runtime environment: development | production | test  [required]
NODE_ENV=development
# TCP port the Express server listens on  [required]
PORT=3000
# Fully-qualified base URL of this API, used for self-referential links and cookie domains  [required]
API_BASE_URL=http://localhost:3000
# Origin of the React/Vite storefront; used for CORS and redirect targets  [required]
CLIENT_APP_URL=http://localhost:5173
# Origin of the in-app admin module; used for CORS allow-list  [required]
ADMIN_APP_URL=http://localhost:5174

# --- MySQL 8 – Primary Datastore ---
# Hostname or IP of the MySQL 8 server  [required]
DB_HOST=127.0.0.1
# MySQL server port  [required]
DB_PORT=3306
# Name of the application database  [required]
DB_NAME=vantage_commerce
# MySQL user the application connects as  [required]
DB_USER=vantage_app
# Password for DB_USER  [required, secret]
DB_PASSWORD=
# Maximum connections in the MySQL pool
DB_CONNECTION_LIMIT=20
# Require TLS for MySQL connections (true in production)
DB_SSL=false

# --- PostgreSQL – Notification Store ---
# Hostname of the PostgreSQL instance that holds the notifications table  [required]
NOTIFY_DB_HOST=127.0.0.1
# PostgreSQL server port  [required]
NOTIFY_DB_PORT=5432
# PostgreSQL database name for the notification store  [required]
NOTIFY_DB_NAME=vantage_notifications
# PostgreSQL user for the notification service  [required]
NOTIFY_DB_USER=vantage_notify
# Password for NOTIFY_DB_USER  [required, secret]
NOTIFY_DB_PASSWORD=
# Require TLS for PostgreSQL connections (true in production)
NOTIFY_DB_SSL=false
# How often (ms) the frontend is expected to poll the notification REST endpoint; documented here for API consistency
NOTIFICATION_POLL_INTERVAL_MS=5000

# --- Authentication & Cryptography ---
# Secret used to sign JWT access tokens; must be at least 32 random bytes  [required, secret]
JWT_SECRET=
# Lifetime of a JWT access token (ms/zeit format, e.g. 15m, 1h)  [required]
JWT_EXPIRES_IN=15m
# Separate secret used to sign refresh tokens  [required, secret]
JWT_REFRESH_SECRET=
# Lifetime of a refresh token  [required]
JWT_REFRESH_EXPIRES_IN=7d
# bcrypt work factor for password hashing (10–14 recommended)  [required]
BCRYPT_SALT_ROUNDS=12
# Seconds before a password-reset token expires  [required]
PASSWORD_RESET_TOKEN_EXPIRES_IN=3600
# Secret used to sign/verify password-reset tokens  [required, secret]
PASSWORD_RESET_SECRET=
# Secret for signing session/refresh-token cookies via cookie-parser  [required, secret]
COOKIE_SECRET=

# --- Elasticsearch – Search & Autocomplete ---
# URL of the Elasticsearch node (or load-balancer) used for product search and autocomplete  [required]
ELASTICSEARCH_NODE=http://localhost:9200
# Username for Elasticsearch basic auth (leave blank if security is disabled locally)
ELASTICSEARCH_USERNAME=elastic
# Password for Elasticsearch basic auth  [secret]
ELASTICSEARCH_PASSWORD=
# API key auth alternative to username/password for hosted Elasticsearch (e.g. Elastic Cloud)  [secret]
ELASTICSEARCH_API_KEY=
# Name of the Elasticsearch index for product catalogue documents  [required]
ELASTICSEARCH_INDEX_PRODUCTS=vantage_products
# Set to false only in local dev when using self-signed certs
ELASTICSEARCH_TLS_REJECT_UNAUTHORIZED=true

# --- Payment Module (Mock / Test Mode) ---
# Active payment adapter: mock (build phase) | stripe | razorpay — controls which adapter is loaded by the provider-agnostic interface  [required]
PAYMENT_PROVIDER=mock
# When PAYMENT_PROVIDER=mock, force every payment attempt to succeed (true) or fail (false)
PAYMENT_MOCK_ALWAYS_SUCCEED=true
# Live/test API key for the real payment gateway; supplied by Vantage post-build — not required during build phase  [secret]
PAYMENT_API_KEY=
# API secret / private key for the payment gateway; supplied by Vantage post-build  [secret]
PAYMENT_API_SECRET=
# Signing secret used to verify inbound payment webhook payloads; supplied by Vantage post-build  [secret]
PAYMENT_WEBHOOK_SECRET=
# Seconds before an unpaid stock reservation is released (≈15 min per REQ-17)  [required]
STOCK_RESERVATION_TTL_SECONDS=900

# --- CORS & Security ---
# Comma-separated list of allowed CORS origins (storefront and admin)  [required]
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Seconds the browser may cache CORS preflight results
CORS_MAX_AGE=86400
# Set to true when Express terminates TLS directly (most prod setups terminate at the load balancer)
HTTPS_ENABLED=false
# Path to TLS certificate file when HTTPS_ENABLED=true
TLS_CERT_PATH=./certs/server.crt
# Path to TLS private key file when HTTPS_ENABLED=true
TLS_KEY_PATH=./certs/server.key
# Number of proxy hops to trust for req.ip (used by rate limiter behind a load balancer)
TRUST_PROXY=1

# --- Rate Limiting ---
# Rate-limit sliding window in milliseconds (default: 15 minutes)  [required]
RATE_LIMIT_WINDOW_MS=900000
# Maximum requests per IP per window for general API routes  [required]
RATE_LIMIT_MAX_REQUESTS=100
# Sliding window in ms for the stricter login/password-reset rate limiter  [required]
RATE_LIMIT_AUTH_WINDOW_MS=900000
# Maximum login/password-reset attempts per IP per auth window  [required]
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# --- Caching – Redis ---
# Redis connection URL used for response caching, stock reservation TTL, and distributed rate limiting in production
REDIS_URL=redis://127.0.0.1:6379
# AUTH password for the Redis instance (omit for unauthenticated local dev)  [secret]
REDIS_PASSWORD=
# Enable TLS for the Redis connection (true in production managed Redis)
REDIS_TLS=false
# Default TTL (seconds) for cached API responses such as product listing pages
CACHE_DEFAULT_TTL_SECONDS=60

# --- Observability & Logging ---
# Minimum log level emitted: error | warn | info | http | debug  [required]
LOG_LEVEL=info
# Log output format: pretty (dev) | json (production/log aggregators)
LOG_FORMAT=pretty
# Toggle HTTP request logging middleware (e.g. morgan) on or off
REQUEST_LOGGING_ENABLED=true
